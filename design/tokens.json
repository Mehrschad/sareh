{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "خَط و نور",
    "version": "1.0.0",
    "description": "منبع یگانه‌ی حقیقت برای رنگ، تایپ، فاصله، هندسه و حرکت. هیچ مقدار طراحی‌ای در ویجت‌ها هارد‌کد نمی‌شود؛ CI این را می‌سنجد.",
    "generated_to": "app/lib/design/tokens.g.dart"
  },

  "palette": {
    "shabLajevard": { "value": "#0A1730", "fa": "شبِ لاجورد" },
    "nileZharf":    { "value": "#122A4E", "fa": "نیلِ ژرف" },
    "firuzeKashi":  { "value": "#2BA8A8", "fa": "فیروزه‌ی کاشی" },
    "zangareRoshan":{ "value": "#5FD3C4", "fa": "زنگارِ روشن" },
    "zareFarr":     { "value": "#E8B04B", "fa": "زرِ فَرّ" },
    "shangarf":     { "value": "#D9503F", "fa": "شنگرف" },
    "khakeKavir":   { "value": "#D9C7A7", "fa": "خاکِ کویر" },
    "sepideSadaf":  { "value": "#F5F0E6", "fa": "سپیدِ صدف" }
  },

  "color": {
    "dark": {
      "background":      "{palette.shabLajevard}",
      "surface":         "{palette.nileZharf}",
      "surfaceRaised":   "#17346090",
      "onBackground":    "{palette.sepideSadaf}",
      "onSurface":       "{palette.sepideSadaf}",
      "onSurfaceMuted":  "{palette.khakeKavir}",
      "action":          "{palette.firuzeKashi}",
      "onAction":        "{palette.shabLajevard}",
      "accentSoft":      "{palette.zangareRoshan}",
      "achievement":     "{palette.zareFarr}",
      "error":           "{palette.shangarf}",
      "outline":         "#2BA8A83D",
      "scrim":           "#0A1730CC",
      "gerehchini":      "#F5F0E60F"
    },
    "light": {
      "background":      "{palette.sepideSadaf}",
      "surface":         "#FFFFFF",
      "surfaceRaised":   "#0A17300A",
      "onBackground":    "{palette.shabLajevard}",
      "onSurface":       "{palette.shabLajevard}",
      "onSurfaceMuted":  "#5A6A82",
      "action":          "#15716D",
      "onAction":        "#FFFFFF",
      "accentSoft":      "#17685C",
      "achievement":     "#8A6520",
      "error":           "#B83A2B",
      "outline":         "#0A173029",
      "scrim":           "#0A173066",
      "gerehchini":      "#0A17300D"
    }
  },

  "colorRules": {
    "neverAdjacent": [["action", "achievement"]],
    "note": "فیروزه و زر هرگز در یک عنصر کنار هم پررنگ نمی‌شوند. زر تنها برای لحظه‌ی دستاورد است؛ اگر همه‌جا باشد دیگر دستاورد نیست.",
    "minContrast": { "bodyText": 4.5, "largeText": 3.0 }
  },

  "font": {
    "display": { "family": "Gulzar",     "role": "نستعلیق — تنها برای لحظه‌ی رونمایی از واژه؛ یک بار در هر صفحه" },
    "body":    { "family": "Vazirmatn",  "role": "کل رابط کاربری", "variable": true, "weightAxis": [100, 900] },
    "data":    { "family": "Vazirmatn",  "role": "شماره، آمار، تایمر", "numerals": "persian" },
    "dyslexic":{ "family": "Estedad",    "role": "حالت دیس‌لکسی", "letterSpacing": 0.06 }
  },

  "typeScale": {
    "base": 16,
    "ratio": 1.25,
    "steps": {
      "xs":   { "size": 12, "lineHeight": 1.75 },
      "sm":   { "size": 14, "lineHeight": 1.75 },
      "md":   { "size": 16, "lineHeight": 1.75 },
      "lg":   { "size": 20, "lineHeight": 1.7 },
      "xl":   { "size": 25, "lineHeight": 1.7 },
      "xxl":  { "size": 31, "lineHeight": 1.7 },
      "h3":   { "size": 39, "lineHeight": 1.7 },
      "h2":   { "size": 49, "lineHeight": 1.7 },
      "h1":   { "size": 61, "lineHeight": 1.7 }
    },
    "rule": "ارتفاع خط برای فارسی هرگز کمتر از ۱٫۷ نیست. فارسی نویسه‌های زیرین و زبرین دارد؛ فشردگی لاتین برایش سم است."
  },

  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40, "xxl": 64 },

  "radius": { "sharp": 4, "input": 10, "card": 20, "capsule": 999 },

  "opacity": {
    "gerehchiniMin": 0.03,
    "gerehchiniMax": 0.06,
    "lockedStation": 0.4,
    "disabled": 0.38
  },

  "motion": {
    "curve": {
      "kamanArash": { "cubic": [0.16, 0.84, 0.24, 1.0], "fa": "کمانِ آرش — سریع در آغاز، آرام در فرود" },
      "kamanTiz":   { "cubic": [0.4, 0.0, 0.2, 1.0],    "fa": "کمانِ تیز — خروج" }
    },
    "duration": {
      "micro":       { "ms": 120,  "curve": "kamanTiz",   "fa": "ریزکنش — فشردن دکمه" },
      "element":     { "ms": 220,  "curve": "kamanArash", "fa": "گذار عنصر" },
      "page":        { "ms": 340,  "curve": "kamanArash", "fa": "گذار صفحه" },
      "hero":        { "ms": 600,  "curve": "kamanArash", "fa": "لحظه‌ی قهرمان — نورِ واژه" },
      "celebration": { "ms": 1200, "curve": "kamanArash", "fa": "جشن پایان منزل" }
    },
    "spring": { "progressBar": { "stiffness": 180, "damping": 20, "mass": 1.0 } },
    "shake":  { "amplitude": 8, "cycles": 3, "ms": 300 }
  },

  "a11y": {
    "minTouchTarget": 48,
    "reducedMotionDisables": ["gerehchiniParallax", "particles", "stationPulse", "flagCloth", "noreVajeh"],
    "note": "در حالت بی‌حرکت، «نورِ واژه» جای انیمیشن، واژه را یک‌باره و کامل نشان می‌دهد. هیچ کارکردی از دست نمی‌رود."
  },

  "signature": {
    "noreVajeh": {
      "fa": "نورِ واژه",
      "startDelayMs": 100,
      "durationMs": 600,
      "strokeWidth": 3.0,
      "glowSigma": 6.0,
      "trailFraction": 0.18,
      "goldParticles": { "count": 3, "atMs": 400, "riseDp": 28, "fadeMs": 500 },
      "note": "تنها جای ولخرجی بصری. رشته‌ی نور مسیر قلم نستعلیق را می‌پیماید؛ باقی رابط ساکت می‌ماند."
    }
  }
}
